# Only needed for plain `next dev` against a separately-running backend
# (e.g. `python -m app.main` on port 8003). Leave unset on Vercel / `vercel dev`
# - the code then defaults to the relative "/api" path, which Vercel's
# services rewrite (see root vercel.json) routes to the backend service.
NEXT_PUBLIC_API_URL=http://localhost:8003
