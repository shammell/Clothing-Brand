MONGODB_URL=mongodb://localhost:27017
DB_NAME=clothing_store
JWT_SECRET_KEY=change-me-to-a-long-random-secret
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b

# Required if this app ever runs as more than one process (uvicorn --workers,
# gunicorn, multiple container replicas) - without it, rate limits are
# tracked per-process instead of across the whole deployment, silently
# multiplying every configured cap by however many processes are running.
# Leave unset for a single-process deployment (e.g. local dev).
# REDIS_URL=redis://localhost:6379
