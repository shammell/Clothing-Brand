MONGODB_URL=mongodb://localhost:27017
DB_NAME=clothing_store
JWT_SECRET_KEY=change-me-to-a-long-random-secret
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b

# Required if this app ever runs as more than one process (uvicorn --workers,
# gunicorn, multiple container replicas) - without it, rate limits are
# tracked per-process instead of across the whole deployment, silently
# multiplying every configured cap by however many processes are running.
# Leave unset for a single-process deployment (e.g. local dev).
# REDIS_URL=redis://localhost:6379

# Set to the number of reverse proxies/load balancers in front of this app
# (e.g. 1 behind a single nginx/CDN) so per-IP rate limiting uses the real
# client IP instead of the proxy's own address. NEVER set this unless every
# one of those hops is infrastructure you control - trusting a hop you don't
# control lets any client forge their apparent IP and dodge per-IP limits.
# Leave at 0 (default) for a direct connection with no reverse proxy.
# TRUSTED_PROXY_HOPS=1
